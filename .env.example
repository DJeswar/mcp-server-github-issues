# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Every value below is a placeholder -- no real credentials belong in this file.

# ---------------------------------------------------------------------------
# Data backend
# ---------------------------------------------------------------------------
# fixture = read server/fixtures/*.json, no network, no credentials (default)
# github  = read the live GitHub REST API
ISSUES_BACKEND=fixture

# Target repository, "owner/name". Used only when ISSUES_BACKEND=github.
GITHUB_REPO=owner/repo

# Fine-grained PAT, read-only on Issues. OPTIONAL:
# unauthenticated public-repo reads work at 60 req/hr, authenticated at 5000.
# Leave blank to run unauthenticated.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# certifi (default) = httpx's bundled CA list.
# system            = trust the OS certificate store instead.
#
# Set this to `system` on a corporate machine whose network does TLS inspection: the proxy
# re-signs certificates with an internal CA that certifi does not carry, and every live request
# (GitHub, Groq and Gemini) otherwise fails with CERTIFICATE_VERIFY_FAILED.
SSL_TRUST_STORE=certifi

# ---------------------------------------------------------------------------
# Determinism
# ---------------------------------------------------------------------------
# Reference "now" for the fixture backend, so time-relative reasoning
# ("stale for more than a week") is reproducible across runs and in CI.
FIXTURE_NOW=2026-08-01T00:00:00Z

# ---------------------------------------------------------------------------
# Agent (Phase 4)
# ---------------------------------------------------------------------------
# stub   = scripted, deterministic, no credentials (default; what CI runs)
# replay = play back cassettes recorded from a live provider; no credentials
# groq   = live Groq (requires GROQ_API_KEY)
# gemini = live Gemini (requires GEMINI_API_KEY)
# auto   = Groq primary + Gemini fallback when both keys exist; either one works alone
LLM_BACKEND=stub

GROQ_API_KEY=
GEMINI_API_KEY=

# Current verified defaults. Override these without changing code when a provider retires a model.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=4096

# Set to 1 alongside a live backend to write request/response cassettes, so CI can later replay
# real model behaviour with no key and no flakiness.
RECORD_CASSETTES=0
# CASSETTE_DIR=evals/cassettes

# Loop safety. These are the limits that must fire before LangGraph's own recursion limit --
# otherwise the framework aborts the run and the "answer with what you have" path never executes.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_WALL_CLOCK=60
AGENT_NO_PROGRESS_LIMIT=2

# ---------------------------------------------------------------------------
# Memory (Phase 4b) -- two stores, deliberately separate mechanisms
# ---------------------------------------------------------------------------
# Long-term: our own `facts` table, gated by the five-gate write rule. Durable.
MEMORY_DB=agent_memory.sqlite3

# Short-term: the LangGraph checkpointer, keyed by thread_id. Disposable.
CHECKPOINT_DB=agent_checkpoints.sqlite3

# Max facts recalled per question. Recall is keyword/key match ranked by use and recency --
# deterministic on purpose, so the Phase 5 eval gate stays meaningful.
AGENT_RECALL_LIMIT=5

# ---------------------------------------------------------------------------
# Guardrails (Phase 4c)
# ---------------------------------------------------------------------------
# enforce = annotate inbound detections, and redact/block outbound problems.
# report  = record identical events but change nothing. That is how the eval suite tells
#           "the guardrail worked" apart from "the model was never tempted".
GUARDRAIL_MODE=enforce

# ---------------------------------------------------------------------------
# Public web app
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=7860
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Set to true on an HTTPS deployment. Render terminates TLS before forwarding to the app, so the
# app cannot always infer the original scheme itself.
SESSION_COOKIE_SECURE=false
